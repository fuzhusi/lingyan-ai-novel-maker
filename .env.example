# ===== 灵砚 (LingYan) 环境变量示例（可选） =====
# 本文件完全可选：应用没有 .env 也能正常运行，
# 模型配置推荐在「设置 → 模型配置」页面完成（存数据库）。
# 仅当想跳过页面配置、用单个 DeepSeek key 快速体验时才需要：
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会上传）
# 其余变量为运行参数（调试/SSL/上传上限/数据库路径），按需修改。

# DeepSeek API 配置
# 申请地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认模型名称（也可启动后在 /settings/llm 页面按 Agent 类型配置不同模型）
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 弃用
MODEL_NAME=deepseek-v4-pro

# Flask 会话签名密钥（表单 flash/会话使用；生产环境务必改成随机长串）
SECRET_KEY=change-me-to-a-random-secret

# 调试模式：仅显式 =1 时开启（默认关闭，避免 Werkzeug 调试器远程执行风险）
LINGYAN_DEBUG=0

# SSL 证书校验：默认强制校验；自签证书的内网地址（localhost/10.x/192.168.x 等）
# 自动豁免。确需对公网域跳过校验时才设为 1（有中间人风险）
LINGYAN_INSECURE_SSL=0

# 上传大小上限（MB，默认 50）
MAX_UPLOAD_MB=50
